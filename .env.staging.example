# Template for the server's .env (staging and live).
# Tobi copies this file to ern-next/shared/.env on the server and fills in the values there.
# Never fill it in here: this file is in the repository and must stay empty.
# On live, set APP_ENV=production. On staging, keep APP_ENV=staging.

APP_NAME="Esports Research Network"
APP_ENV=staging
# Leave empty: the first upload creates the key on the server.
APP_KEY=
APP_DEBUG=false
# For staging: https://next.esportsresearch.net
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# From the customer area (docs/HUMAN_TODO.md, R0-09 step 4).
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# From the customer area (R0-09 step 5). MAIL_USERNAME is the mailbox's login name
# as shown there (like m0123456, or the address). MAIL_FROM_ADDRESS is the mailbox address.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Without a value, the default in config/ern.php applies.
# ERN_SUBMISSION_URL=https://esportsresearch.net/submission/
# ERN_LIVE_NEXT=
# ERN_EVENT_TIMEZONE=Europe/Berlin
# APP_VERSION is set by the upload itself.
